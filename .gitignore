# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/
functions/node_modules/
.firebase/
firebase-config*.json
*-service-account.json
*.keystore
*.jks
android/key.properties
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Emulator-only switches (never deployed)
functions/.env.local

# Service-type browse list: only the .webp files + JSON are bundled into
# the app (see pubspec.yaml); the same-named .png files are kept on disk
# as full-quality backups only, and the samples/ folder is unused extras
# -- neither is needed in version control.
assets/services/*.png
assets/services/samples/

# Generated image batches / zips / contact sheets (large, reproducible)
output/

# Source images for the built-in category photos (the app bundles the optimized
# copies in assets/category_icons/ instead).
website-images/
category-icons/

# Per-flavor Android Firebase configs (never committed)
android/app/src/*/google-services.json

# Play Console upload keys (keep them outside the project; this is a safety net)
play-service-account*.json
*-service-account*.json
fastlane/report.xml

# Play upload tool and service-account keys
e-commerce-app-*.json
# Project settings for the functions (Gmail sender address, Razorpay public key id): kept out of git.
functions/.env.e-commerce-app-a3897
# Scratch files and Android build output of the SMS forwarder tool: never committed.
tmp/
tools/sms-forwarder/.gradle/
tools/sms-forwarder/**/build/
tools/sms-forwarder/local.properties
# Image sets (zips and folders of design pictures, about 120 MB): kept outside git.
locamarket-characters.zip
locamarket-characters/
locamarket-locations.zip
locamarket-locations/

# One-time hexagon script (tools/hex): its own packages; the WorldPop file is kept outside the repo.
tools/hex/node_modules/
