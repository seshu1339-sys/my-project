rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function isImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    // Mirrors firestore.rules' adminSessionValid(): the admin custom claim alone
    // is not enough once email OTP is required (functions/admin-otp.js is the
    // only writer of _adminSessions). Without this, a direct Storage write would
    // bypass the OTP requirement entirely, since Storage rules never go through
    // the callable functions that enforce it.
    function adminSessionValid() {
      return firestore.exists(/databases/(default)/documents/_adminSessions/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/_adminSessions/$(request.auth.uid)).data.expiresAt.toMillis() > request.time.toMillis();
    }
    function isAdmin() { return verified() && request.auth.token.admin == true && adminSessionValid(); }
    match /catalog/{file} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAdmin();
    }
    // Private vendor application photos: the owner may upload the two named
    // photos only before submitting (or after a rejection); only the owner and
    // the main admin can read them. They are never public.
    match /vendorApplications/{uid}/{file} {
      allow read: if verified() && (request.auth.uid == uid || isAdmin());
      allow create, update: if verified() && request.auth.uid == uid
        && file in ['vendorPhoto', 'shopPhoto'] && isImage()
        && (!firestore.exists(/databases/(default)/documents/vendorApplications/$(uid))
          || firestore.get(/databases/(default)/documents/vendorApplications/$(uid)).data.status == 'rejected');
    }
    // Product/material photos: only an approved vendor may upload, into its own folder.
    // Special Category Exclusives photos reuse this same path/rule (see functions/exclusives.js).
    match /vendorProducts/{uid}/{file} {
      allow read: if true;
      allow create, update: if verified() && request.auth.uid == uid && isImage()
        && firestore.exists(/databases/(default)/documents/vendors/$(uid))
        && firestore.get(/databases/(default)/documents/vendors/$(uid)).data.status == 'approved';
    }
    // Up to settings/business.vendorPhotoLimit shop photos per vendor (default 2), fixed
    // filenames shopPhoto1..shopPhoto9. The actual configured limit is enforced by
    // submitShopPhoto/reviewShopPhoto (functions/vendor-photos.js); this rule only fixes a
    // generous ceiling, since reading a dynamic admin setting here would need an extra
    // cross-service read on every upload. Public read (the Firestore vendorShopPhotos doc's
    // status gates customer visibility); write is limited to the owning, approved vendor.
    match /vendorShopPhotos/{uid}/{file} {
      allow read: if true;
      allow create, update: if verified() && request.auth.uid == uid
        && file.matches('shopPhoto[1-9]') && isImage()
        && firestore.exists(/databases/(default)/documents/vendors/$(uid))
        && firestore.get(/databases/(default)/documents/vendors/$(uid)).data.status == 'approved';
    }
    // Field Assistant: the staff member's own mandatory registration photo —
    // mirrors vendorApplications' exact shape (owner-writable only before the
    // fieldStaff doc exists, or again after a rejection; owner+admin read only).
    match /fieldStaffApplications/{uid}/{file} {
      allow read: if verified() && (request.auth.uid == uid || isAdmin());
      allow create, update: if verified() && request.auth.uid == uid
        && file == 'staffPhoto' && isImage()
        && (!firestore.exists(/databases/(default)/documents/fieldStaff/$(uid))
          || firestore.get(/databases/(default)/documents/fieldStaff/$(uid)).data.status == 'rejected');
    }
    // Field Assistant: a staff member's own submission photos, one arbitrary
    // filename per visit (not fixed-slot, since a staff member submits many
    // over time). Private — the customer app never reads these directly; an
    // approved entry's photo is copied into the public catalog/ path instead.
    match /fieldSubmissions/{uid}/{file} {
      allow read: if verified() && (request.auth.uid == uid || isAdmin());
      allow create, update: if verified() && request.auth.uid == uid && isImage()
        && firestore.exists(/databases/(default)/documents/fieldStaff/$(uid))
        && firestore.get(/databases/(default)/documents/fieldStaff/$(uid)).data.status == 'active';
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
