<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- Customer app: no outside ad network, only shops' own ads from Firestore, so no advertising ID.
         "remove" also stops a library from adding it back. Play Console's Advertising ID declaration must say "No". -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
</manifest>
