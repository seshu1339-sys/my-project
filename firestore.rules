rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    // Password + admin claim alone no longer grants admin access: a recent,
    // successful email-OTP verification (functions/admin-otp.js, which is the
    // only writer of _adminSessions) must also exist and not have expired.
    // This closes the same gap for every DIRECT client read/write below that
    // functions/admin-session.js closes for callable functions.
    function adminSessionValid() {
      return exists(/databases/$(database)/documents/_adminSessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/_adminSessions/$(request.auth.uid)).data.expiresAt > request.time;
    }
    function admin() { return signedIn() && request.auth.token.admin == true && adminSessionValid(); }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    match /{collection}/{id} {
      allow read: if collection in ['products', 'categories', 'shops', 'promotions', 'settings', 'productImageLibrary'];
      allow write: if admin() && collection in ['products', 'categories', 'shops', 'promotions', 'settings', 'productImageLibrary'];
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      // Client saves merge one or two of these fields at a time (profile name,
      // language, saved card display, wishlist); each is validated only when present.
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'language', 'paymentBrand', 'paymentLast4', 'wishlist'])
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 100))
        && (!('language' in request.resource.data) || (request.resource.data.language is string && request.resource.data.language.size() <= 10))
        && (!('paymentBrand' in request.resource.data) || (request.resource.data.paymentBrand is string && request.resource.data.paymentBrand.size() <= 30))
        && (!('paymentLast4' in request.resource.data) || (request.resource.data.paymentLast4 is string && request.resource.data.paymentLast4.size() <= 4))
        && (!('wishlist' in request.resource.data) || (request.resource.data.wishlist is list && request.resource.data.wishlist.size() <= 500));
    }
    match /vendorApplications/{uid} {
      allow read: if owner(uid) || admin();
      allow write: if false;
    }
    match /vendors/{uid} {
      allow read: if owner(uid) || admin();
      allow write: if false;
    }
    match /vendorChanges/{changeId} {
      allow read: if admin() || (signedIn() && resource.data.vendorId == request.auth.uid);
      allow write: if false;
    }
    // Up to 2 shop photos per vendor, each pending until the admin approves it. No
    // sensitive data here (status/timestamps only), so read is public like products/shops —
    // clients filter to status == 'approved' before showing one to a customer.
    match /vendorShopPhotos/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /purchaseCodes/{codeId} {
      allow read, write: if false;
    }
    match /verifiedPurchases/{purchaseId} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || resource.data.vendorId == request.auth.uid || admin());
      allow write: if false;
    }
    match /suspiciousReviews/{reviewId} {
      allow read: if admin();
      allow write: if false;
    }
    match /complaints/{complaintId} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || resource.data.vendorId == request.auth.uid || admin());
      allow write: if false;
    }
    match /complaints/{complaintId}/messages/{messageId} {
      allow read: if signedIn() && (get(/databases/$(database)/documents/complaints/$(complaintId)).data.customerId == request.auth.uid
        || get(/databases/$(database)/documents/complaints/$(complaintId)).data.vendorId == request.auth.uid || admin());
      allow write: if false;
    }
    match /users/{uid}/pushTokens/{tokenId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
        && request.resource.data.token == tokenId && tokenId.size() <= 2048
        && request.resource.data.updatedAt == request.time;
    }
    match /notificationSubscribers/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['enabled', 'updatedAt'])
        && request.resource.data.enabled is bool
        && request.resource.data.updatedAt == request.time;
    }
    match /products/{productId}/viewers/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      // Product interest. Current apps also count views (viewCount goes up by exactly one per
      // write); the server adds alert bookkeeping fields that clients can neither set nor change.
      allow create, update: if signedIn() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/products/$(productId))
        && request.resource.data.pincode is string
        && request.resource.data.pincode.matches('^([0-9]{6})?$')
        && request.resource.data.lastViewedAt == request.time
        && (
          // older apps: the original two-field record
          request.resource.data.keys().hasOnly(['pincode', 'lastViewedAt'])
          // current apps: a counted view, touching only these fields
          || (resource == null
              ? request.resource.data.keys().hasOnly(['pincode', 'lastViewedAt', 'viewCount']) && request.resource.data.viewCount == 1
              : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pincode', 'lastViewedAt', 'viewCount'])
                && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1)
        );
    }
    // Site and ad analytics: written only by the trackEvent function, readable only by the admin.
    match /analyticsDaily/{id} { allow read: if admin(); allow write: if false; }
    match /analyticsTotals/{id} { allow read: if admin(); allow write: if false; }
    match /analyticsAds/{id} { allow read: if admin(); allow write: if false; }
    match /products/{productId}/reviews/{uid} {
      allow read: if true;
      allow delete: if admin() || (signedIn() && request.auth.uid == uid);
    }
    match /orders/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin()
        || (get(/databases/$(database)/documents/vendors/$(request.auth.uid)).data.shopId in resource.data.shopIds));
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['submitted', 'confirmed', 'fulfilled', 'cancelled'];
    }
    // PIN hashes, rate limits, and orders are created only by trusted functions.
    match /{document=**} { allow read, write: if false; }
  }
}
