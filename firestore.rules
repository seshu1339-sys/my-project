rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every app signs in with its OWN login for its role (functions/role-logins.js), with the claims {role, loginEmail}: one email has
    // a separate login, and so a separate uid, as a customer ('user'), vendor, service provider, staff member and administrator. All
    // the "own record" checks below compare uids, so one role never reads another role's records, even for the same email. The
    // email's own login (Google, email code, password) only proves the email: it has no role and reads or writes nothing here.
    function signedIn() { return request.auth != null && request.auth.token.role in ['user', 'vendor', 'provider', 'staff', 'admin']; }
    function signedInAs(role) { return signedIn() && request.auth.token.role == role; }
    // Password + admin claim alone no longer grants admin access: a recent,
    // successful email-OTP verification (functions/admin-otp.js, which is the
    // only writer of _adminSessions) must also exist and not have expired.
    // This closes the same gap for every DIRECT client read/write below that
    // functions/admin-session.js closes for callable functions.
    function adminSessionValid() {
      return exists(/databases/$(database)/documents/_adminSessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/_adminSessions/$(request.auth.uid)).data.expiresAt > request.time;
    }
    // Admin power is only on the administrator's own login (role 'admin'), never on the same email's other logins.
    function admin() { return signedInAs('admin') && request.auth.token.admin == true && adminSessionValid(); }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    match /{collection}/{id} {
      allow read: if collection in ['products', 'services', 'categories', 'shops', 'promotions', 'settings', 'productImageLibrary', 'locations'];
      allow write: if admin() && collection in ['products', 'services', 'categories', 'shops', 'promotions', 'settings', 'productImageLibrary', 'locations'];
    }
    // Unified Ads: customers read the ads (what is shown on the site); only the admin writes them directly, vendors go through functions.
    // adsPrivate holds the admin-only side of an ad (shop contact, amount, paid, notes) and is never readable by the public.
    match /ads/{id} {
      allow read: if true;
      allow write: if admin();
    }
    match /adsPrivate/{id} {
      allow read, write: if admin();
    }
    // Sample data (functions/samples.js): the accounts the sample data belongs to and the log of "Delete all samples". Only the admin
    // reads them (for the SAMPLE label); only functions and the sample script write them.
    match /_sampleAccounts/{id} {
      allow read: if admin();
      allow write: if false;
    }
    match /_sampleDeletions/{id} {
      allow read: if admin();
      allow write: if false;
    }
    // Ad view counts are written only by functions/ad-tracking.js. The admin reads everything (including the view-by-view log);
    // a vendor reads the totals of their own ads. adViewGuard and adUniques are internal and never readable.
    match /adStats/{id} {
      allow read: if admin() || (signedIn() && resource.data.vendorId == request.auth.uid);
      allow write: if false;
    }
    match /adStatsDaily/{id} {
      allow read: if admin() || (signedIn() && resource.data.vendorId == request.auth.uid);
      allow write: if false;
    }
    // Vendor ads: a vendor reads their own submissions (pending / approved / rejected) and notices; functions write them.
    match /adSubmissions/{id} {
      allow read: if admin() || (signedIn() && resource.data.vendorId == request.auth.uid);
      allow write: if false;
    }
    match /vendorNotices/{id} {
      allow read: if admin() || (signedIn() && resource.data.vendorId == request.auth.uid);
      allow write: if false;
    }
    match /adViews/{id} {
      allow read: if admin();
      allow write: if false;
    }
    // Shop ads in the Right Side Ad Boxes (functions/shop-ads.js): the admin reads all, a vendor reads their own (when it started,
    // which box, live or ended); written only by functions. The public settings carry only the ad id.
    match /rightBoxAds/{id} {
      allow read: if admin() || (signedIn() && resource.data.vendorId == request.auth.uid);
      allow write: if false;
    }
    // Staff "Add" (functions/staff-additions.js): the admin reads every addition, a staff member their own; written only by functions.
    match /staffAdditions/{id} {
      allow read: if admin() || (signedIn() && resource.data.staffUid == request.auth.uid);
      allow write: if false;
    }
    // The admin's "Google check" of photos (functions/photo-check.js): the results and this month's count of scans, admin only.
    // photoFingerprints stays server-only (no rule).
    match /photoChecks/{id} {
      allow read: if admin();
      allow write: if false;
    }
    match /photoCheckUsage/{month} {
      allow read: if admin();
      allow write: if false;
    }
    // Usage analytics (functions/usage.js), written only by functions: the admin reads everything; a shop owner, service provider or
    // staff member reads their own numbers. _usageDevices stays server-only (no rule).
    match /usageDaily/{id} {
      allow read: if admin();
      allow write: if false;
    }
    match /usagePersonDaily/{id} {
      allow read: if admin();
      allow write: if false;
    }
    match /userActivity/{uid} {
      allow read: if admin();
      allow write: if false;
    }
    // The push notification centre (functions/push-center.js): admin only; written only by functions.
    match /pushLog/{nid} {
      allow read: if admin();
      allow write: if false;
      match /recipients/{uid} {
        allow read: if admin();
        allow write: if false;
      }
    }
    match /pushTypeDaily/{id} {
      allow read: if admin();
      allow write: if false;
    }
    // Inactive accounts (functions/inactive-accounts.js): what the sweep did and each account's disabled / deleted state; admin only.
    match /inactiveSweeps/{day} {
      allow read: if admin();
      allow write: if false;
    }
    match /accountStates/{uid} {
      allow read: if admin();
      allow write: if false;
    }
    match /usageOwnerDaily/{id} {
      allow read: if admin() || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow write: if false;
    }
    // Quick Add Item: accounts are created and switched on/off only by the admin (functions);
    // an account can read its own record. Items are written only by functions. The public sees
    // only APPROVED items (the site also checks the start/end time); owners and the admin see all.
    match /quickAccounts/{uid} {
      allow read: if owner(uid) || admin();
      allow write: if false;
    }
    match /quickItems/{id} {
      allow read: if resource.data.status == 'approved'
        || (signedIn() && resource.data.ownerUid == request.auth.uid) || admin();
      allow write: if false;
    }
    // Each login's own profile and preferences (name, language, wishlist). Every role login has its own uid, so a customer's profile is
    // never read by the same email's vendor or staff login, and the reverse.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      // Client saves merge one or two of these fields at a time (profile name,
      // language, saved card display, wishlist); each is validated only when present.
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'language', 'paymentBrand', 'paymentLast4', 'wishlist'])
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 100))
        && (!('language' in request.resource.data) || (request.resource.data.language is string && request.resource.data.language.size() <= 10))
        && (!('paymentBrand' in request.resource.data) || (request.resource.data.paymentBrand is string && request.resource.data.paymentBrand.size() <= 30))
        && (!('paymentLast4' in request.resource.data) || (request.resource.data.paymentLast4 is string && request.resource.data.paymentLast4.size() <= 4))
        && (!('wishlist' in request.resource.data) || (request.resource.data.wishlist is list && request.resource.data.wishlist.size() <= 500));
    }
    // The vendor app has two logins (vendor and service provider). Either may read the record under ITS OWN uid in these four
    // collections, so the app can tell which one it is (the Help chat reads all four: lib/modules/flash/flash_module.dart). A login's
    // uid never holds the other kind's record, so this shows nothing new; other people's records stay closed (13 Nov 2026 fix for
    // "The chat could not open: permission-denied").
    match /vendorApplications/{uid} {
      allow read: if ((signedInAs('vendor') || signedInAs('provider')) && owner(uid)) || admin();
      allow write: if false;
    }
    match /vendors/{uid} {
      allow read: if ((signedInAs('vendor') || signedInAs('provider')) && owner(uid)) || admin();
      allow write: if false;
    }
    // Service providers (the email's provider login, separate from its vendor login): written only by functions/providers.js.
    match /providerApplications/{uid} {
      allow read: if ((signedInAs('provider') || signedInAs('vendor')) && owner(uid)) || admin();
      allow write: if false;
    }
    match /providers/{uid} {
      allow read: if ((signedInAs('provider') || signedInAs('vendor')) && owner(uid)) || admin();
      allow write: if false;
    }
    match /vendorChanges/{changeId} {
      allow read: if admin() || (signedIn() && resource.data.vendorId == request.auth.uid);
      allow write: if false;
    }
    // Up to settings/business.vendorPhotoLimit shop photos per vendor (default 3), each
    // pending until the admin approves it. No
    // sensitive data here (status/timestamps only), so read is public like products/shops —
    // clients filter to status == 'approved' before showing one to a customer.
    match /vendorShopPhotos/{docId} {
      allow read: if true;
      allow write: if false;
    }
    // Showcase module (functions/modules/showcase): the paid vendors' box photo and reach (km), public like shops; only functions write.
    match /vendorShowcase/{uid} {
      allow read: if true;
      allow write: if false;
    }
    // Photo limits module (functions/modules/photo-limits): a vendor's own item photo waiting for the admin's check.
    match /vendorItemPhotos/{productId} {
      allow read: if admin() || (signedIn() && resource.data.vendorId == request.auth.uid);
      allow write: if false;
    }
    // Field Assistant: a staff role doc (mirrors vendors/{uid}) and a pending-
    // then-approved submission queue (mirrors vendorChanges). Kept entirely
    // separate from the vendor collections above — a different role, reviewed
    // in its own admin section, never merged with vendor moderation.
    match /fieldStaff/{uid} {
      allow read: if (signedInAs('staff') && owner(uid)) || admin();
      allow write: if false;
    }
    match /fieldSubmissions/{id} {
      allow read: if admin() || (signedIn() && resource.data.staffUid == request.auth.uid);
      allow write: if false;
    }
    match /purchaseCodes/{codeId} {
      allow read, write: if false;
    }
    match /verifiedPurchases/{purchaseId} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || resource.data.vendorId == request.auth.uid || admin());
      allow write: if false;
    }
    match /suspiciousReviews/{reviewId} {
      allow read: if admin();
      allow write: if false;
    }
    match /complaints/{complaintId} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || resource.data.vendorId == request.auth.uid || admin());
      allow write: if false;
    }
    match /complaints/{complaintId}/messages/{messageId} {
      allow read: if signedIn() && (get(/databases/$(database)/documents/complaints/$(complaintId)).data.customerId == request.auth.uid
        || get(/databases/$(database)/documents/complaints/$(complaintId)).data.vendorId == request.auth.uid || admin());
      allow write: if false;
    }
    match /users/{uid}/pushTokens/{tokenId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
        && request.resource.data.token == tokenId && tokenId.size() <= 2048
        && request.resource.data.updatedAt == request.time;
    }
    match /notificationSubscribers/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      // pincode/latitude/longitude are optional: only ever set for a customer
      // who has already opted into push notifications, from the same
      // last-known location already used client-side (never continuous
      // background tracking).
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['enabled', 'updatedAt', 'pincode', 'latitude', 'longitude', 'area'])
        // area: the place name the customer sees (Kancharapalem), for the "Offers near ..." notification.
        && (!('area' in request.resource.data) || (request.resource.data.area is string && request.resource.data.area.size() <= 80))
        && request.resource.data.enabled is bool
        && request.resource.data.updatedAt == request.time
        && (!('pincode' in request.resource.data) || (request.resource.data.pincode is string && request.resource.data.pincode.matches('^([0-9]{6})?$')))
        && (!('latitude' in request.resource.data) || (request.resource.data.latitude is number && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90))
        && (!('longitude' in request.resource.data) || (request.resource.data.longitude is number && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180));
    }
    match /products/{productId}/viewers/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      // Product interest. Current apps also count views (viewCount goes up by exactly one per
      // write); the server adds alert bookkeeping fields that clients can neither set nor change.
      allow create, update: if signedIn() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/products/$(productId))
        && request.resource.data.pincode is string
        && request.resource.data.pincode.matches('^([0-9]{6})?$')
        && request.resource.data.lastViewedAt == request.time
        && (
          // older apps: the original two-field record
          request.resource.data.keys().hasOnly(['pincode', 'lastViewedAt'])
          // current apps: a counted view, touching only these fields
          || (resource == null
              ? request.resource.data.keys().hasOnly(['pincode', 'lastViewedAt', 'viewCount']) && request.resource.data.viewCount == 1
              : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pincode', 'lastViewedAt', 'viewCount'])
                && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1)
        );
    }
    // Site and ad analytics: written only by the trackEvent function, readable only by the admin.
    match /analyticsDaily/{id} { allow read: if admin(); allow write: if false; }
    match /analyticsTotals/{id} { allow read: if admin(); allow write: if false; }
    match /analyticsAds/{id} { allow read: if admin(); allow write: if false; }
    // AI Admin Agent (optional admin-only module, functions/ai-agent-*.js): every
    // document here is written only by those Cloud Functions, never directly by
    // a client. The admin UI streams these four collections live; everything
    // else the module needs (credentials, PIN hashes, confirmation tokens, device
    // tokens) lives under _-prefixed collections instead, covered by the default
    // deny below, since the admin UI never needs to read those directly.
    match /aiAgentConfig/{moduleId} { allow read: if admin(); allow write: if false; }
    match /aiAgentMessages/{id} { allow read: if admin(); allow write: if false; }
    match /aiAgentPendingActions/{id} { allow read: if admin(); allow write: if false; }
    match /aiAgentAuditLog/{id} { allow read: if admin(); allow write: if false; }
    match /aiAgentRoles/{uid} { allow read: if admin(); allow write: if false; }
    match /products/{productId}/reviews/{uid} {
      allow read: if true;
      allow delete: if admin() || (signedIn() && request.auth.uid == uid);
    }
    // A customer login reads its own orders; a vendor login reads the orders of its own shop. The same email's other login never does.
    match /orders/{id} {
      allow read: if admin()
        || (signedInAs('user') && resource.data.userId == request.auth.uid)
        || (signedInAs('vendor') && get(/databases/$(database)/documents/vendors/$(request.auth.uid)).data.shopId in resource.data.shopIds);
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['submitted', 'confirmed', 'fulfilled', 'cancelled'];
    }
    // Subscription Plans module (functions/modules/plans): vendors read the plans as the admin made them and their own plan; functions write everything.
    match /vendorPlans/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /planServiceGates/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /vendorPlanPeriods/{id} {
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }
    match /vendorPlanStatus/{uid} {
      allow read: if owner(uid) || admin();
      allow write: if false;
    }
    // A payment request is the only meeting point of the plans and payment modules; a person reads their own, functions write them.
    match /paymentRequests/{id} {
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }
    // Vendor Offers module (functions/modules/vendor-offers): anyone reads a live offer, a vendor their own, the admin all; functions write everything.
    match /vendorOffers/{id} {
      allow read: if resource.data.status == 'live' || admin() || (signedIn() && resource.data.vendorId == request.auth.uid);
      allow write: if false;
    }
    // Staff Area System (functions/modules/staff-areas): areas and towns for signed-in staff (green / red on the map); who holds an area is
    // admin only; a staff member reads their own record and days. Only functions write.
    match /staffAreaTowns/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /staffAreas/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /staffAreaHolders/{id} {
      allow read: if admin();
      allow write: if false;
    }
    match /staffAreaStaff/{uid} {
      allow read: if owner(uid) || admin();
      allow write: if false;
    }
    match /staffAreaSettings/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /staffAreaDays/{id} {
      allow read: if admin() || (signedIn() && resource.data.staffUid == request.auth.uid);
      allow write: if false;
    }
    // Staff Links module (functions/modules/staff-links): who registered a vendor / provider; read only for the staff member and the person.
    match /staffLinks/{id} {
      allow read: if admin() || (signedIn() && (resource.data.staffUid == request.auth.uid || resource.data.accountUid == request.auth.uid));
      allow write: if false;
    }
    // Offer Alerts module (functions/modules/offer-alerts): the one-alert-a-day limit and how many each alert reached; admin only.
    match /vendorOfferAlerts/{vendorId} {
      allow read: if admin();
      allow write: if false;
      match /sent/{offerId} {
        allow read: if admin();
        allow write: if false;
      }
    }
    match /vendorOffersConfig/{id} {
      allow read: if admin();
      allow write: if false;
    }
    // Premium status module (functions/modules/premium-status): a vendor reads their own; only functions write it.
    match /vendorPremium/{uid} {
      allow read: if owner(uid) || admin();
      allow write: if false;
    }
    // Today's Offer module (functions/modules/todays-offer): offers are public like promotions; the apps choose which to show. Functions write them.
    match /vendorTodaysOffers/{uid} {
      allow read: if true;
      allow write: if false;
    }
    // Wholesale module (functions/modules/wholesale): holds phone numbers, so only the admin and vendors with a running plan read it.
    match /wholesaleOffers/{id} {
      allow read: if admin() || (signedIn()
        && get(/databases/$(database)/documents/vendorPremium/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/vendorPremium/$(request.auth.uid)).data.endsAt > request.time);
      allow write: if false;
    }
    // Payment module (functions/modules/payments, Razorpay): vendors read only whether payments are open; the switch and the used
    // payment ids are admin only. Only functions write.
    match /paymentPublic/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /paymentSettings/{id} {
      allow read: if admin();
      allow write: if false;
    }
    match /paymentIds/{id} {
      allow read: if admin();
      allow write: if false;
    }
    // ai-core (functions/modules/ai-core): the log of every AI call is for the admin; the daily counts are for functions only.
    match /aiCallLog/{id} {
      allow read: if admin();
      allow write: if false;
    }
    match /aiDailyUse/{id} { allow read, write: if false; }
    // Flash module (functions/modules/flash): a person reads their own chats in each of the three separate collections, the admin reads all.
    // Tickets, their AI suggestions, the counts and the settings are for the admin only. Functions write everything.
    match /flashUserChats/{id} {
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
      match /messages/{messageId} {
        allow read: if admin() || (signedIn() && get(/databases/$(database)/documents/flashUserChats/$(id)).data.uid == request.auth.uid);
        allow write: if false;
      }
    }
    match /flashVendorChats/{id} {
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
      match /messages/{messageId} {
        allow read: if admin() || (signedIn() && get(/databases/$(database)/documents/flashVendorChats/$(id)).data.uid == request.auth.uid);
        allow write: if false;
      }
    }
    match /flashPremiumChats/{id} {
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
      match /messages/{messageId} {
        allow read: if admin() || (signedIn() && get(/databases/$(database)/documents/flashPremiumChats/$(id)).data.uid == request.auth.uid);
        allow write: if false;
      }
    }
    match /flashProviderChats/{id} {
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
      match /messages/{messageId} {
        allow read: if admin() || (signedIn() && get(/databases/$(database)/documents/flashProviderChats/$(id)).data.uid == request.auth.uid);
        allow write: if false;
      }
    }
    // The office phone / WhatsApp the Premium vendors' chat shows (written by saveFlashConfig).
    match /flashPublic/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /flashStaffChats/{id} {
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
      match /messages/{messageId} {
        allow read: if admin() || (signedIn() && get(/databases/$(database)/documents/flashStaffChats/$(id)).data.uid == request.auth.uid);
        allow write: if false;
      }
    }
    match /flashTickets/{id} {
      allow read: if admin();
      allow write: if false;
    }
    match /flashTicketTriage/{id} {
      allow read: if admin();
      allow write: if false;
    }
    match /flashStats/{id} {
      allow read: if admin();
      allow write: if false;
    }
    match /flashConfig/{id} {
      allow read: if admin();
      allow write: if false;
    }
    // PIN hashes, rate limits, and orders are created only by trusted functions.
    match /{document=**} { allow read, write: if false; }
  }
}
