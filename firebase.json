{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "hosting": [
    {
      "target": "customer",
      "public": "build/web",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "/",
          "headers": [{"key": "Cache-Control", "value": "no-cache"}]
        },
        {
          "source": "**/*.@(html|js|json)",
          "headers": [{"key": "Cache-Control", "value": "no-cache"}]
        },
        {
          "source": "/data/**",
          "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
        }
      ],
      "rewrites": [
        {"source": "/privacy-policy", "destination": "/privacy-policy.html"},
        {"source": "/privacy-policy/", "destination": "/privacy-policy.html"},
        {"source": "/delete-account", "destination": "/delete-account.html"},
        {"source": "/delete-account/", "destination": "/delete-account.html"},
        {"source": "**", "destination": "/index.html"}
      ]
    },
    {
      "target": "admin",
      "public": "build/admin_web",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "/",
          "headers": [{"key": "Cache-Control", "value": "no-cache"}]
        },
        {
          "source": "**/*.@(html|js|json)",
          "headers": [{"key": "Cache-Control", "value": "no-cache"}]
        },
        {
          "source": "/data/**",
          "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
        }
      ],
      "rewrites": [{"source": "**", "destination": "/index.html"}]
    },
    {
      "target": "vendor",
      "public": "build/vendor_web",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "/",
          "headers": [{"key": "Cache-Control", "value": "no-cache"}]
        },
        {
          "source": "**/*.@(html|js|json)",
          "headers": [{"key": "Cache-Control", "value": "no-cache"}]
        },
        {
          "source": "/data/**",
          "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
        }
      ],
      "rewrites": [{"source": "**", "destination": "/index.html"}]
    },
    {
      "target": "field",
      "public": "build/field_web",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "/",
          "headers": [{"key": "Cache-Control", "value": "no-cache"}]
        },
        {
          "source": "**/*.@(html|js|json)",
          "headers": [{"key": "Cache-Control", "value": "no-cache"}]
        },
        {
          "source": "/data/**",
          "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
        }
      ],
      "rewrites": [{"source": "**", "destination": "/index.html"}]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true
    }
  }
}
